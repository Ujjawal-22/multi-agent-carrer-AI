# Copy this file to .env and fill in real values. .env is git-ignored.

# --- App ---
APP_ENV=development
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+psycopg2://career_ai:career_ai@localhost:5432/career_ai

# --- LLM Provider ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Vector DB (Phase 4) ---
QDRANT_URL=http://localhost:6333

# --- Observability (Phase 8) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Logging ---
LOG_LEVEL=INFO

# --- Matching Agent weights (optional overrides; defaults sum to 1.0) ---
# MATCH_WEIGHT_TECHNICAL_SKILL=0.35
# MATCH_WEIGHT_ATS_KEYWORD=0.20
# MATCH_WEIGHT_EXPERIENCE_PROJECT=0.25
# MATCH_WEIGHT_EDUCATION=0.10
# MATCH_WEIGHT_DOMAIN=0.10

# --- RAG (optional overrides; defaults are sensible) ---
# QDRANT_COLLECTION_NAME=career_ai_knowledge_base
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIMENSIONS=768
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=100
# RAG_TOP_K=5
